# ============================================================
#  VARIABLES DE ENTORNO
#  Copia este archivo como ".env" y completa los valores.
#  En Netlify se configuran en: Site settings > Environment variables
#  NO subas el archivo .env a Git.
# ============================================================

# --- Base de datos (MongoDB Atlas) ---
# Connection string: Atlas > Connect > Drivers
MONGODB_URI=mongodb+srv://USUARIO_Y_CONTRASENA@cluster0.xxxxx.mongodb.net
MONGODB_DB=portafolio

# --- Correo (Gmail) ---
# EMAIL_USER: el Gmail que ENVÍA los resúmenes
EMAIL_USER=davidvareladavid@gmail.com

# EMAIL_PASS: App Password de Google (NO tu contraseña normal)
# Créala en: https://myaccount.google.com/apppasswords
# Requiere tener la verificación en 2 pasos activada.
EMAIL_PASS=(pega aqui tu App Password de Gmail)

# EMAIL_DESTINO: a quién llegan los avisos (tú mismo)
EMAIL_DESTINO=davidvareladavid@gmail.com

# --- Seguridad del cron ---
# Clave secreta para que nadie más dispare el resumen diario.
# Genera una con:  openssl rand -hex 20
CRON_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria

# --- Panel de habilidades (/admin) ---
# Tu email de administrador. Es el único que puede entrar al panel
# y el único que recibe los códigos para cambiar la contraseña.
ADMIN_EMAIL=davidvareladavid@gmail.com

# Contraseña INICIAL del panel. Solo se usa la primera vez, para crear
# el administrador en la base de datos. Después puedes cambiarla desde
# el propio panel (por email) y esta variable deja de importar.
# Reglas: mínimo 8 caracteres, con al menos una letra y un número.
ADMIN_PASSWORD=cambia_esta_contrasena_inicial

# Clave con la que se firman los tokens de sesión.
# Genera una con:  openssl rand -hex 32
ADMIN_TOKEN_SECRET=clave_aleatoria_larga_para_firmar_el_token

# --- General ---
SITE_URL=https://tu-portafolio.netlify.app
TZ=America/Santiago

# ============================================================
#  VARIABLES PARA EL FRONTEND (React/Vite)
#  Deben empezar con VITE_ para ser leídas por el navegador.
#  Si publicas frontend y backend en el MISMO sitio Netlify,
#  déjalo vacío y usará rutas relativas (/api/...).
# ============================================================
VITE_API_URL=